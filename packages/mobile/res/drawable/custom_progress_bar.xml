<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="4.0dp" />
            <gradient android:startColor="#1a1a2e" android:endColor="#1a1a2e" android:angle="270.0" android:centerColor="#1a1a2e" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="4.0dp" />
                <gradient android:startColor="#d946ef" android:endColor="#5880f7" android:angle="0.0" />
            </shape>
        </clip>
    </item>
</layer-list>
