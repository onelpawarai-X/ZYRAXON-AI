<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:background="@drawable/bg_solid" android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.appcompat.widget.Toolbar android:id="@id/toolbar" android:background="?colorPrimary" android:layout_width="match_parent" android:layout_height="?actionBarSize" app:title="Create Trigger" app:titleTextColor="@color/white" />
    <ScrollView android:id="@id/scrollView" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:layout_below="@id/toolbar">
        <LinearLayout android:orientation="vertical" android:padding="16.0dp" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:text="Task Instruction" style="@style/PermissionHeading" />
            <EditText android:textColor="@color/white" android:textColorHint="#8a8a8e" android:gravity="top" android:id="@id/instructionEditText" android:background="@drawable/edit_text_border" android:padding="12.0dp" android:scrollbars="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="e.g., 'Read the notification'" android:maxLines="5" android:minLines="2" android:inputType="textMultiLine" />
            <LinearLayout android:orientation="vertical" android:id="@id/scheduledTimeOptions" android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout android:orientation="vertical" android:id="@id/alarmPermissionWarning" android:background="@drawable/warning_background" android:padding="8.0dp" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16.0dp">
                    <TextView android:textStyle="bold" android:textColor="@color/white" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Permission Required" />
                    <TextView android:textColor="@color/white" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="To schedule tasks at precise times, MYRA needs the 'Alarms &amp; Reminders' permission." />
                    <Button android:id="@id/grantAlarmPermissionButton" android:background="@drawable/rounded_button_secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8.0dp" android:text="Grant Permission" />
                </LinearLayout>
                <TextView android:text="Set Trigger Time" style="@style/PermissionHeading" />
                <TimePicker android:theme="@style/AppTheme.NumberPicker" android:id="@id/timePicker" android:layout_width="match_parent" android:layout_height="wrap_content" android:timePickerMode="spinner" />
                <TextView android:layout_marginTop="8.0dp" android:text="Repeat on" style="@style/PermissionHeading" />
                <com.google.android.material.chip.ChipGroup android:id="@id/dayOfWeekChipGroup" android:layout_width="match_parent" android:layout_height="wrap_content" app:singleSelection="false">
                    <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="S" style="@style/Widget.MaterialComponents.Chip.Filter" />
                    <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="M" style="@style/Widget.MaterialComponents.Chip.Filter" />
                    <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="T" style="@style/Widget.MaterialComponents.Chip.Filter" />
                    <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="W" style="@style/Widget.MaterialComponents.Chip.Filter" />
                    <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="T" style="@style/Widget.MaterialComponents.Chip.Filter" />
                    <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="F" style="@style/Widget.MaterialComponents.Chip.Filter" />
                    <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="S" style="@style/Widget.MaterialComponents.Chip.Filter" />
                </com.google.android.material.chip.ChipGroup>
            </LinearLayout>
            <LinearLayout android:orientation="vertical" android:id="@id/notificationOptions" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout android:orientation="vertical" android:id="@id/notificationPermissionWarning" android:background="@drawable/warning_background" android:padding="8.0dp" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16.0dp">
                    <TextView android:textStyle="bold" android:textColor="@color/white" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Permission Required" />
                    <TextView android:textColor="@color/white" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="To read notifications, MYRA needs permission to access them." />
                    <Button android:id="@id/grantNotificationPermissionButton" android:background="@drawable/rounded_button_secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8.0dp" android:text="Grant Permission" />
                </LinearLayout>
                <CheckBox android:textColor="@color/white" android:id="@id/selectAllAppsCheckbox" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="All Applications" />
                <TextView android:text="Select App" style="@style/PermissionHeading" />
                <EditText android:textColor="@color/white" android:textColorHint="#8a8a8e" android:id="@id/searchEditText" android:background="@drawable/edit_text_border" android:padding="12.0dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8.0dp" android:hint="Search Apps" android:inputType="text" />
                <androidx.recyclerview.widget.RecyclerView android:id="@id/appsRecyclerView" android:layout_width="match_parent" android:layout_height="200.0dp" android:layout_marginTop="8.0dp" />
            </LinearLayout>
            <LinearLayout android:orientation="vertical" android:id="@id/chargingStateOptions" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:text="Trigger When" style="@style/PermissionHeading" />
                <RadioGroup android:orientation="vertical" android:id="@id/chargingStatusRadioGroup" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <RadioButton android:textColor="@color/white" android:id="@id/radioConnected" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:text="Power Connected" />
                    <RadioButton android:textColor="@color/white" android:id="@id/radioDisconnected" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Power Disconnected" />
                </RadioGroup>
            </LinearLayout>
            <LinearLayout android:gravity="center_horizontal" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24.0dp">
                <Button android:textColor="@color/white" android:id="@id/testTriggerButton" android:background="@drawable/rounded_button_secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Test Trigger" android:paddingStart="24.0dp" android:paddingEnd="24.0dp" android:layout_marginEnd="8.0dp" />
                <Button android:textColor="@color/white" android:id="@id/saveTriggerButton" android:background="@drawable/rounded_button" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Save Trigger" android:paddingStart="32.0dp" android:paddingEnd="32.0dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
