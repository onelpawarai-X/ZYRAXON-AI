# ==========================================================================
# ZYRAXON-AI gitignore
#
# Policy: every project file is committed. Only true build output and
# dependency installs are excluded.
#
# Two hard exceptions remain:
#   1. dist/ and out/  - regenerable build output
#   2. *.exe/.msi/...  - GitHub rejects any single file over 100 MB
# ==========================================================================

# --- Build output (the only project directories we exclude) ---------------
dist/
out/

# --- Release binaries: GitHub hard-fails any single file over 100 MB ------
*.exe
*.msi
*.dmg
*.deb
*.rpm
*.AppImage
*.snap
*.flatpak

# --- Dependency installs (NOT project source) ---------------------------
node_modules/

# ...except the vendored runtime assets the desktop app ships with.
# Re-include the directory first, then its contents, because git cannot
# descend into an excluded parent directory.
!packages/desktop/resources/node_modules/
!packages/desktop/resources/node_modules/**
!packages/desktop/resources/*/node_modules/
!packages/desktop/resources/*/node_modules/**

# --- Secrets: never commit real credentials ------------------------------
.env
.env.*
!.env.example
!.env.template
*.pem
*.key
*.p12
*.pfx

# --- Local tooling state -------------------------------------------------
.worktrees
.sst
.turbo
.idea
.DS_Store
*~
Thumbs.db

# --- Patched electron-vite configs (contain machine-specific paths) -----
packages/desktop/electron.vite.config.*.mjs

# --- Sync tooling output (regenerated by scripts/full-sync.ts) ------------
.sync-manifest.txt
.git/sync-verify-index
.git/sync-verify-result
