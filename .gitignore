# ==========================================================================
# ZYRAXON-AI gitignore
#
# Policy: every project file is committed. Only true build output and
# dependency installs are excluded.
#
# Two hard exceptions remain:
#   1. dist/ and out/  - regenerable build output
#   2. *.exe/.msi/...  - GitHub rejects any single file over 100 MB
# ==========================================================================

# --- Build output (the only project directories we exclude) ---------------
dist/
out/

# --- Release binaries: GitHub hard-fails any single file over 100 MB ------
*.exe
*.msi
*.dmg
*.deb
*.rpm
*.AppImage
*.snap
*.flatpak

# --- Dependency installs (NOT project source) ---------------------------
node_modules/

# --- Runtime state kept inside the workspace (databases, caches, tmp) ----
# The workspace-local data root the serve script points every XDG location
# at. It is machine state, not project source, and it is large.
.zyraxon-data/

# ...except the vendored runtime assets the desktop app ships with.
# Re-include the directory first, then its contents, because git cannot
# descend into an excluded parent directory.
!packages/desktop/resources/node_modules/
!packages/desktop/resources/node_modules/**
!packages/desktop/resources/*/node_modules/
!packages/desktop/resources/*/node_modules/**

# --- Secrets: never commit real credentials ------------------------------
.env
.env.*
!.env.example
!.env.template
*.pem
*.key
*.p12
*.pfx

# --- Local tooling state -------------------------------------------------
.worktrees
.sst
.turbo
.idea
.DS_Store
*~
Thumbs.db

# --- Patched electron-vite configs (contain machine-specific paths) -----
packages/desktop/electron.vite.config.*.mjs

# --- Sync tooling output (regenerated by scripts/full-sync.ts) ------------
.sync-manifest.txt
.git/sync-verify-index
.git/sync-verify-result

# --- Ad hoc sync shell wrappers and logs -------------------------------
# The sync scripts live in scripts/; their one-off wrappers and logs do not.
/.sync-*.log
/.sync-*.ps1
/.pr-body.md

.agent_tmp/
agent-work/

# --- Python bytecode from bundled MCP servers -------------------------
__pycache__/
*.pyc

# --- MCP Hub catalog intermediates -------------------------------------
# The harvest pages, the normalized registry snapshot and the verification logs
# are inputs to the build, not product: 277 MB of raw registry pages sit here
# after a run, and every file is reproducible by re-running the scripts in
# MCP Hub/scripts. The catalog the app ships is catalog/verified-index.ts, which
# is generated from these and is tracked.
MCP Hub/data/

# --- Local tooling state -----------------------------------------------
# Editor/agent scratch directories and the small databases the local MCP
# servers keep. They are per-machine state, not product, and none of them
# belongs in a release tarball.
.cursor/
.oura/
.rsi/
quickpeek.config.json
reviews.db
safe-ssh-mcp.log
zenbrain.db
