node_modules
dist
dist-ssr
*.local

# The desktop app ships these as vendored runtime assets, not installs, so
# they stay tracked. git cannot descend into an excluded parent directory,
# so the directory is re-included before its contents.
!resources/node_modules/
!resources/node_modules/**
!resources/*/node_modules/
!resources/*/node_modules/**

