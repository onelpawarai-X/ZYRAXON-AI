            },
            "publish": {
              "type": "boolean",
              "description": "%config.showActionButton.publish%"
            },
            "sync": {
              "type": "boolean",
              "description": "%config.showActionButton.sync%"
            }
          },
          "default": {
            "commit": true,
            "publish": true,
            "sync": true
          },
          "scope": "resource"
        },
        "git.statusLimit": {
