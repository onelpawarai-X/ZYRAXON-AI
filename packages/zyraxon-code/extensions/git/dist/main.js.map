        "git.showProgress": {
          "type": "boolean",
          "description": "%config.showProgress%",
          "default": true,
          "scope": "resource",
          "agentsWindow": {
            "default": false,
            "readOnly": true
          }
        },
        "git.rebaseWhenSync": {
          "type": "boolean",
          "scope": "resource",
          "default": false,
          "description": "%config.rebaseWhenSync%"
        },
        "git.pullBeforeCheckout": {
          "type": "boolean",
          "scope": "resource",
          "default": false,
          "description": "%config.pullBeforeCheckout%"
