          "scope": "resource",
          "default": true,
          "description": "%config.detectSubmodules%"
        },
        "git.detectSubmodulesLimit": {
          "type": "number",
          "scope": "resource",
          "default": 10,
          "description": "%config.detectSubmodulesLimit%"
        },
        "git.detectWorktrees": {
          "type": "boolean",
          "scope": "resource",
          "default": false,
          "description": "%config.detectWorktrees%",
          "agentsWindow": {
            "default": false
